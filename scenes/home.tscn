[sub_resource type="Shader" id="Shader_vig"]
code = "shader_type canvas_item;
void fragment() {
	float d = distance(UV, vec2(0.5));
	float v = smoothstep(0.42, 0.95, d);
	COLOR = vec4(0.05, 0.03, 0.02, v * 0.55);
}"

